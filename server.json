{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.motioneed/motioneed",
  "description": "Turn a product URL or one sentence into a launch video (MP4) with your real brand and interface.",
  "title": "Motioneed",
  "version": "1.0.1",
  "websiteUrl": "https://www.motioneed.com/developers?ref=mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.motioneed.com/mcp",
      "headers": [
        {
          "description": "Bearer followed by your Motioneed API key (mk_...). Create one at https://www.motioneed.com/account?ref=mcp",
          "isRequired": true,
          "value": "Bearer {api_key}",
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "Motioneed API key (mk_...)",
              "isRequired": true,
              "isSecret": true
            }
          },
          "name": "Authorization"
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/motioneed/motioneed-mcp",
    "source": "github"
  }
}